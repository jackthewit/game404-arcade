{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/s/:game", "destination": "/api/share?game=:game" },
    { "source": "/api/config", "destination": "/api/config.js" },
    { "source": "/api/kakaopay/ready", "destination": "/api/kakaopay/ready.js" },
    { "source": "/api/kakaopay/approve", "destination": "/api/kakaopay/approve.js" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
